{
  "name": "calendar",
  "version": "0.6.1-ha.10",
  "private": true,
  "type": "module",
  "description": "Home Assistant family dashboard with Google Calendar, private iCal feeds, weather and photos.",
  "license": "MIT",
  "keywords": [
    "calendar",
    "dashboard",
    "home-assistant",
    "google-calendar",
    "ical",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test server/test/",
    "contract": "node scripts/gen-contract.mjs"
  },
  "dependencies": {
    "cookie-session": "^2.1.1",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "node-ical": "^0.27.3",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.6",
    "heic-to": "^1.6.5",
    "preact": "^11.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
